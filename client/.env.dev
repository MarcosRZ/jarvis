# Client settings for "make run" (ENV=dev). This file is committed: keep
# secrets out of it. Without VOICE_HA_TOKEN here, "make run" uses the token
# that "make ha-up" saved in server/homeassistant/dev-token.
VOICE_CONFIG=client/config.yaml
VOICE_HA_URL=http://127.0.0.1:8123
VOICE_LLM_URL=http://127.0.0.1:8080
VOICE_LLM_MODE=fallback
# "aquí" in a request means this room (see docs/commands.md#language-model).
VOICE_ROOM=Salon
# Learned sentences and feedback (git-ignored); set it to off to turn learning off.
VOICE_LEARNING_FILE=client/data/learning-dev.json
VOICE_LOG_LEVEL=debug
VOICE_LOG_TRANSCRIPTS=true
