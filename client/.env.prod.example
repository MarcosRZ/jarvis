# Client settings for "make run ENV=prod". Copy this file to client/.env.prod
# (not committed), fill it in, and run "chmod 600 client/.env.prod".
# The variables are the ones in docs/configuration.md.
VOICE_CONFIG=client/config.yaml
VOICE_HA_URL=http://homeassistant.local:8123
VOICE_HA_TOKEN=
# Conversation agent for the exposed devices that are not lights or switches,
# and for questions such as the weather. Empty uses the default agent.
# VOICE_HA_AGENT=conversation.ollama
# Local language model (llama.cpp in server/compose.yaml). It can answer
# questions and choose one or more actions (up to four) from the safe catalog
# generated from the exposed entities, or turn_on/turn_off an allowlisted
# light or switch. The Home Assistant conversation agent handles everything
# else.
VOICE_LLM_URL=http://127.0.0.1:8080
# fallback: unresolved sentences; off.
VOICE_LLM_MODE=fallback
# Inferred-action safety: guard (only plausible actions), literal (any model action), states (only physical states).
VOICE_LLM_SAFETY=guard
# Fallback order for unresolved sentences: ha-first (Home Assistant before
# the model) or model-first. A deterministic catalog match always runs first;
# use model-first if you want the model to learn phrases that Home Assistant
# would otherwise handle.
VOICE_LLM_ORDER=ha-first
# VOICE_LLM_TIMEOUT=30s
# Room where the assistant is, so that "aquí" (for example "hay demasiada luz
# aquí") means that room. Empty when unknown.
VOICE_ROOM=Salon
# Learned sentence-to-action associations and feedback. The file is
# git-ignored; set it to off to turn learning off.
VOICE_LEARNING_FILE=client/data/learning.json
# Where "voice-client actions" writes the generated catalog snapshot. The
# assistant regenerates it at runtime; this file is only for inspection.
# VOICE_ACTIONS_FILE=client/data/actions.json
# true logs what Whisper heard ("msg=heard text=..."); the text can be private.
VOICE_LOG_TRANSCRIPTS=false
# host:port of the read-only log web page, kept only in memory; for example
# 0.0.0.0:8081 to read the log from another computer. Empty for off.
# Do not use 8080: the local language model listens there.
VOICE_LOG_HTTP_ADDR=
# host:port where "run" accepts text commands for "voice-client text".
# 127.0.0.1:8082 is the default and only listens on this computer.
# VOICE_TEXT_ADDR=127.0.0.1:8082
