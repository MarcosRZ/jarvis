# Client settings for "make run ENV=prod". Copy this file to client/.env.prod
# (not committed), fill it in, and run "chmod 600 client/.env.prod".
# The variables are the ones in docs/configuration.md.
VOICE_CONFIG=client/config.yaml
VOICE_HA_URL=http://homeassistant.local:8123
VOICE_HA_TOKEN=
# true logs what Whisper heard ("msg=heard text=..."); the text can be private.
VOICE_LOG_TRANSCRIPTS=false
# host:port of the read-only log web page, kept only in memory; for example
# 0.0.0.0:8080 to read the log from another computer. Empty for off.
VOICE_LOG_HTTP_ADDR=
