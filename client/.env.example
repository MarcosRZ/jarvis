# Client settings for "make run". Copy this file to client/.env
# (not committed), fill it in, and run "chmod 600 client/.env".
# "make run ENV=dev" uses the committed client/.env.dev instead.
# Every non-secret setting is listed here; a flag wins over the file.
VOICE_CONFIG=client/config.yaml
VOICE_HA_URL=http://homeassistant.local:8123
VOICE_HA_TOKEN=
# Conversation agent for sentences that the action catalog does not resolve,
# and for questions such as the weather. Empty uses the default agent.
# VOICE_HA_AGENT=conversation.ollama

# Voice pipeline. Empty device names use the system default.
# VOICE_WAKEWORD_ADDR=127.0.0.1:10400
# VOICE_STT_ADDR=127.0.0.1:10300
# VOICE_TTS_ADDR=127.0.0.1:10200
# VOICE_INPUT_DEVICE=
# VOICE_OUTPUT_DEVICE=
# Keep the output device open while the assistant runs, so an idle Bluetooth
# sink does not suspend and swallow the beep. false lets the device sleep.
# VOICE_KEEP_OUTPUT_AWAKE=true
# Diagnostic microphone tails: 3s after each reply and 3s before each wake-word
# detection. Empty turns them off; only the newest files are kept.
# VOICE_TAIL_DIR=client/data/tails
# VOICE_TAIL_SECONDS=3s
# VOICE_TAIL_KEEP=10
# VOICE_WAKEWORD_MODEL=alexa
# VOICE_WAKEWORD_COOLDOWN=2s
# High-pass cutoff for the wake-word audio only, to reject mains rumble and
# low-frequency noise; 0 turns it off. 120 Hz is a good start.
# VOICE_WAKEWORD_HIGHPASS=120
# VOICE_STT_LANGUAGE=es
# VOICE_RECORD_MAX=8s
# VOICE_RECORD_START_TIMEOUT=3s
# VOICE_RECORD_END_SILENCE=1s
# Raise this in a noisy room; lower it when quiet speech is cut.
# VOICE_SPEECH_LEVEL=-40
# VOICE_TTS_VOICE=es_ES-sharvard-medium
# VOICE_TTS_SPEAKER=F
# VOICE_CONNECT_TIMEOUT=3s
# VOICE_OPERATION_TIMEOUT=30s

# Dashboard prompt editor (M4nhattan > Settings). The assistant reads it at
# startup; an empty value or an unreachable dashboard uses the built-in prompt.
# VOICE_PROMPT_URL=http://127.0.0.1:3005/api/settings/prompt

# Dashboard Settings overrides (M4nhattan > Settings > Client). The assistant
# reads them before the rest of the configuration, so they win over this file;
# an unreachable dashboard falls back to this file. Set it to off to disable the
# lookup.
VOICE_SETTINGS_URL=http://127.0.0.1:3005/api/settings/client

# Dashboard Learning page. The assistant posts a snapshot of the learned
# phrases (recognized speech, so private) at startup, after a change and every
# 60 seconds, and polls edits at <url>/operations every 2 seconds. Set it to off
# to disable publishing and remote edits.
# VOICE_LEARNING_URL=http://127.0.0.1:3005/api/learning

# Local language model (llama.cpp in server/compose.yaml). It can answer
# questions and choose one or more actions (up to four) from the safe catalog
# generated from the exposed entities, or turn_on/turn_off an allowlisted
# light or switch. The Home Assistant conversation agent handles everything
# else.
VOICE_LLM_URL=http://127.0.0.1:8080
# VOICE_LLM_MODEL=local
# VOICE_LLM_API_KEY=
# fallback: unresolved sentences; off.
VOICE_LLM_MODE=fallback
# Inferred-action safety: guard (only plausible actions), literal (any model action), states (only physical states).
VOICE_LLM_SAFETY=guard
# Fallback order for unresolved sentences: ha-first (Home Assistant before
# the model) or model-first. A deterministic catalog match always runs first;
# use model-first if you want the model to learn phrases that Home Assistant
# would otherwise handle.
VOICE_LLM_ORDER=ha-first
# VOICE_LLM_TIMEOUT=30s
# Room where the assistant is, so that "aquí" (for example "hay demasiada luz
# aquí") means that room. Empty when unknown.
VOICE_ROOM=Salon
# Learned sentence-to-action associations and feedback. The file is
# git-ignored; set it to off to turn learning off.
# VOICE_NEWS_URL=http://127.0.0.1:8091

VOICE_LEARNING_FILE=client/data/learning.json
# Where "voice-client actions" writes the generated catalog snapshot. The
# assistant regenerates it at runtime; this file is only for inspection.
# VOICE_ACTIONS_FILE=client/data/actions.json
# Logging. true logs what Whisper heard ("msg=heard text=..."); the text can be private.
VOICE_LOG_LEVEL=info
VOICE_LOG_TRANSCRIPTS=false
# host:port of the read-only log web page, kept only in memory; for example
# 0.0.0.0:8081 to read the log from another computer. Empty for off.
# Do not use 8080: the local language model listens there.
VOICE_LOG_HTTP_ADDR=
# host:port where "run" accepts text commands for "voice-client text".
# 127.0.0.1:8082 is the default and only listens on this computer.
# VOICE_TEXT_ADDR=127.0.0.1:8082
