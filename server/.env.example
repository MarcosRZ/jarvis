BIND_ADDRESS=127.0.0.1

OPENWAKEWORD_PORT=10400
WAKEWORD_THRESHOLD=0.5
WAKEWORD_REFRACTORY_SECONDS=2

WHISPER_PORT=10300
WHISPER_MODEL=base
WHISPER_LANGUAGE=es
WHISPER_INITIAL_PROMPT=¿Qué hora es? Repite lo que he dicho. Cancela. ¿Qué puedes hacer?
# Speed on a slow CPU, for example the Windows PC: WHISPER_COMPUTE_TYPE=int8
# (about 40 % faster, same results) and WHISPER_CPU_THREADS=<number of cores>.
# Keep WHISPER_BEAM_SIZE=0: 1 was not faster and less accurate.
WHISPER_COMPUTE_TYPE=default
WHISPER_BEAM_SIZE=0
WHISPER_CPU_THREADS=4
# Speech engine: faster-whisper (Whisper), or sherpa with WHISPER_MODEL=auto for
# NVIDIA Parakeet (about 3 times faster on the Mac; no initial prompt).
WHISPER_STT_LIBRARY=faster-whisper

PIPER_PORT=10200
PIPER_VOICE=es_ES-sharvard-medium

# Local language model for commands that the fixed parser does not understand.
# "make services-up" downloads the model into server/models/llm on first use.
# The downloader and run.ps1 know only the default LLM_MODEL; put another file
# in server/models/llm yourself.
LLM_PORT=8080
# Expose only the language model to the LAN; the other services stay on
# BIND_ADDRESS. Use 127.0.0.1 for a local-only model.
LLM_BIND_ADDRESS=127.0.0.1
LLM_MODEL=qwen2.5-0.5b-instruct-q4_k_m.gguf
LLM_CTX_SIZE=4096
LLM_THREADS=4
LLM_ROPE_SCALING=none
LLM_ROPE_SCALE=1
LLM_YARN_ORIG_CTX=0
# To serve more context than the model's training window (e.g. 65536 for
# Hermes Agent, which requires >=64000), use LLM_CTX_SIZE=65536,
# LLM_ROPE_SCALING=yarn and LLM_ROPE_SCALE=2 for Qwen2.5 (32768 native).

# Development Home Assistant (make ha-up)
HA_PORT=8123
TZ=Europe/Madrid

# M4nhattan dashboard
DASHBOARD_PORT=3005

